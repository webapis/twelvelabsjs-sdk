{
  "name": "@twelvelabs/sdk",
  "version": "0.1.0",
  "description": "Official JavaScript SDK for Twelve Labs Video Understanding Platform",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./version": {
      "import": "./dist/version.mjs",
      "require": "./dist/version.cjs",
      "types": "./dist/version.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:types && npm run build:bundle",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "build:bundle": "rollup -c",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:all": "npm run test:unit && npm run test:integration",
    "docs:build": "typedoc",
    "docs:serve": "npx serve docs-build",
    "version:bump:patch": "npm version patch --no-git-tag-version",
    "version:bump:minor": "npm version minor --no-git-tag-version",
    "version:bump:major": "npm version major --no-git-tag-version",
    "version:sync": "node scripts/sync-versions.js",
    "version:verify": "node scripts/verify-version-sync.js",
    "version:info": "node scripts/version-info.js",
    "prebuild": "npm run version:sync",
    "predocs:build": "npm run version:sync",
    "prerelease": "npm run version:sync && npm run test:all && npm run build",
    "release:validate": "node scripts/validate-release.js",
    "prepare": "husky install"
  },
  "keywords": [
    "twelvelabs",
    "video-understanding",
    "video-search",
    "video-analysis",
    "embeddings",
    "ai",
    "computer-vision",
    "multimodal"
  ],
  "author": "Twelve Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/twelvelabs-io/twelvelabs-js"
  },
  "bugs": {
    "url": "https://github.com/twelvelabs-io/twelvelabs-js/issues"
  },
  "homepage": "https://docs.twelvelabs.io",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^17.2.3",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.5",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "rollup": "^4.9.4",
    "ts-jest": "^29.1.1",
    "typedoc": "^0.25.6",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}

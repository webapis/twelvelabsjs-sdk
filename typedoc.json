{
  "entryPoints": [
    "src/index.ts"
  ],
  "entryPointStrategy": "expand",
  "exclude": [
    "**/internal/**",
    "**/utils/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "categorizeByGroup": true,
  "categoryOrder": [
    "Client",
    "Resources",
    "Request Types",
    "Response Types",
    "Errors",
    "*"
  ],
  "readme": "README.md",
  "name": "Twelve Labs JavaScript SDK v0.1.0",
  "out": "docs-build",
  "includeVersion": true
}